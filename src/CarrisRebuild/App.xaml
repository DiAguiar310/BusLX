<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CarrisRebuild.Services"
             x:Class="CarrisRebuild.App">
  <Application.Resources>
    <ResourceDictionary>
      <services:RouteColorConverter x:Key="RouteColor" />

      <!-- Identidade BusLX: azul Carris, amarelo de sinalética e tinta escura. -->
      <Color x:Key="BrandYellow">#FFCC00</Color>
      <Color x:Key="BrandBlue">#00569F</Color>
      <Color x:Key="BrandInk">#1D1D1B</Color>
      <Color x:Key="BrandBlack">#1D1D1B</Color>
      <Color x:Key="AppBackground">#F4F8FC</Color>
      <Color x:Key="CardWhite">#FFFFFF</Color>
      <Color x:Key="BlueSoft">#E8F1FA</Color>
      <Color x:Key="YellowSoft">#FFF4CC</Color>
      <Color x:Key="OnBlueMuted">#D6E7F5</Color>
      <Color x:Key="Muted">#5E6B78</Color>
      <Color x:Key="Line">#DDE7F0</Color>
      <Color x:Key="LineStrong">#C7D7E7</Color>

      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}" />
      </Style>

      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="FontSize" Value="14" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandYellow}" />
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandYellow}" />
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
      </Style>

      <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="TextColor" Value="{StaticResource CardWhite}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
      </Style>

      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
      </Style>

      <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardWhite}" />
        <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
      </Style>

      <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style x:Key="HeroCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style x:Key="RouteHero" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style x:Key="IconTile" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="BorderColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
      </Style>

      <Style x:Key="SectionBar" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource BrandYellow}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="WidthRequest" Value="4" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
      </Style>

      <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="CharacterSpacing" Value="1.2" />
      </Style>

      <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
      </Style>

      <Style x:Key="Pill" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="BorderColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

      <Style x:Key="PillText" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="CharacterSpacing" Value="0.6" />
      </Style>

      <Style x:Key="LiveDot" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource BrandYellow}" />
        <Setter Property="WidthRequest" Value="6" />
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

      <Style x:Key="RouteBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandYellow}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandYellow}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinimumWidthRequest" Value="46" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

      <Style x:Key="RouteBadgeText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
      </Style>

      <Style x:Key="StopBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="BorderColor" Value="{StaticResource BlueSoft}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumWidthRequest" Value="46" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

      <Style x:Key="StopBadgeText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
      </Style>

      <Style x:Key="SearchCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="HeightRequest" Value="50" />
      </Style>

      <Style x:Key="SearchEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
