<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarrisRebuild.Models"
             xmlns:services="clr-namespace:CarrisRebuild.Services"
             x:Class="CarrisRebuild.Pages.HomePage" BackgroundColor="{StaticResource AppBackground}"
             Title="Início">
  <ScrollView>
    <VerticalStackLayout Padding="18,14,18,30" Spacing="18">

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Image Source="brand_mark.png" WidthRequest="48" HeightRequest="48"
               Aspect="AspectFit" VerticalOptions="Center" />
        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
          <Label Text="BusLX" FontSize="27" FontAttributes="Bold" />
          <Label Text="Lisboa em movimento" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <Frame Grid.Column="2" Style="{StaticResource Pill}" Padding="10,5">
          <HorizontalStackLayout Spacing="6">
            <BoxView Style="{StaticResource LiveDot}" />
            <Label Text="AO VIVO" Style="{StaticResource PillText}" />
          </HorizontalStackLayout>
        </Frame>
      </Grid>

      <Frame Style="{StaticResource HeroCard}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="MAPA AO VIVO" FontSize="10" FontAttributes="Bold"
                   TextColor="{StaticResource BrandYellow}" CharacterSpacing="1.4"
                   VerticalOptions="Center" />
            <Frame Grid.Column="1" BackgroundColor="{StaticResource BrandYellow}"
                   BorderColor="{StaticResource BrandYellow}" CornerRadius="99"
                   Padding="8,4" HasShadow="False">
              <Label Text="TEMPO REAL" FontSize="9" FontAttributes="Bold"
                     TextColor="{StaticResource BrandInk}" CharacterSpacing="0.5" />
            </Frame>
          </Grid>
          <Label Text="Toda a rede, num só ecrã." FontSize="24" FontAttributes="Bold"
                 TextColor="{StaticResource CardWhite}" />
          <Label Text="Autocarros, paragens e chegadas em tempo real."
                 FontSize="13" TextColor="{StaticResource OnBlueMuted}" />
          <Button Text="Abrir mapa" Style="{StaticResource PrimaryButton}"
                  Clicked="OnMap" Margin="0,4,0,0" />
        </VerticalStackLayout>
      </Frame>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Frame Style="{StaticResource Card}" Padding="14">
          <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnStops" />
          </Frame.GestureRecognizers>
          <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <Frame Style="{StaticResource IconTile}">
                <Image Source="icon_stops.png" WidthRequest="22" HeightRequest="22"
                       Aspect="AspectFit" />
              </Frame>
              <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource BrandBlue}"
                     HorizontalOptions="End" VerticalOptions="Start" />
            </Grid>
            <Label x:Name="StopCountLabel" Text="—" FontSize="26" FontAttributes="Bold" />
            <Label Text="paragens na rede" Style="{StaticResource MutedText}" />
          </VerticalStackLayout>
        </Frame>

        <Frame Grid.Column="1" Style="{StaticResource Card}" Padding="14">
          <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnRoutes" />
          </Frame.GestureRecognizers>
          <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <Frame Style="{StaticResource IconTile}">
                <Image Source="icon_routes.png" WidthRequest="22" HeightRequest="22"
                       Aspect="AspectFit" />
              </Frame>
              <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource BrandBlue}"
                     HorizontalOptions="End" VerticalOptions="Start" />
            </Grid>
            <Label x:Name="RouteCountLabel" Text="—" FontSize="26" FontAttributes="Bold" />
            <Label Text="carreiras na rede" Style="{StaticResource MutedText}" />
          </VerticalStackLayout>
        </Frame>
      </Grid>

      <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <BoxView Style="{StaticResource SectionBar}" />
          <Label Grid.Column="1" Text="Paragens favoritas" Style="{StaticResource SectionTitle}" />
        </Grid>
        <Label Text="Próximas chegadas das paragens que guardaste."
               Style="{StaticResource MutedText}" Margin="14,0,0,0" />
      </VerticalStackLayout>

      <Frame Style="{StaticResource Card}" Padding="14,4">
        <VerticalStackLayout x:Name="FavList" Spacing="0">
          <BindableLayout.EmptyViewTemplate>
            <DataTemplate>
              <VerticalStackLayout Padding="4,14" Spacing="3">
                <Label Text="Ainda não guardaste paragens." FontAttributes="Bold" />
                <Label Text="Abre uma paragem e toca em Guardar para a veres aqui."
                       Style="{StaticResource MutedText}" />
              </VerticalStackLayout>
            </DataTemplate>
          </BindableLayout.EmptyViewTemplate>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:FavoriteStopCard">
              <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,11">
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavStop" />
                  </Grid.GestureRecognizers>
                  <Frame BackgroundColor="{StaticResource BrandYellow}"
                         BorderColor="{StaticResource BrandYellow}" CornerRadius="14"
                         Padding="0" WidthRequest="28" HeightRequest="28"
                         HasShadow="False" VerticalOptions="Start" Margin="0,1,0,0">
                    <Label Text="★" TextColor="{StaticResource BrandInk}" FontSize="13"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Frame>
                  <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="{Binding Name}" FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Next}" Spacing="3">
                      <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:EstimationDto">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <Frame BackgroundColor="{Binding RouteNumber, Converter={StaticResource RouteColor}}"
                                   BorderColor="{Binding RouteNumber, Converter={StaticResource RouteColor}}"
                                   CornerRadius="6" HasShadow="False" Padding="5,2"
                                   MinimumWidthRequest="34" HorizontalOptions="Start"
                                   VerticalOptions="Center">
                              <Label Text="{Binding RouteNumber}"
                                     TextColor="{Binding RouteNumber, Converter={StaticResource RouteColor}, ConverterParameter=Text}"
                                     FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                            </Frame>
                            <Label Grid.Column="1" Text="{Binding Headsign}" FontSize="12"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding EtaText}" FontAttributes="Bold"
                                   FontSize="12" VerticalOptions="Center" />
                          </Grid>
                        </DataTemplate>
                      </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="A carregar chegadas…" Style="{StaticResource MutedText}"
                           FontSize="12" IsVisible="{Binding Loading}" />
                    <Label Text="Sem chegadas de momento." Style="{StaticResource MutedText}"
                           FontSize="12" IsVisible="{Binding NoNext}" />
                  </VerticalStackLayout>
                  <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource BrandBlue}"
                         VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
              </VerticalStackLayout>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </Frame>

      <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <BoxView Style="{StaticResource SectionBar}" />
          <Label Grid.Column="1" Text="Carreiras favoritas" Style="{StaticResource SectionTitle}" />
        </Grid>
      </VerticalStackLayout>

      <Frame Style="{StaticResource Card}" Padding="14,4">
        <VerticalStackLayout x:Name="FavRouteList" Spacing="0">
          <BindableLayout.EmptyViewTemplate>
            <DataTemplate>
              <VerticalStackLayout Padding="4,14" Spacing="3">
                <Label Text="Ainda não guardaste carreiras." FontAttributes="Bold" />
                <Label Text="Guarda uma carreira para acederes mais depressa."
                       Style="{StaticResource MutedText}" />
              </VerticalStackLayout>
            </DataTemplate>
          </BindableLayout.EmptyViewTemplate>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="services:FavoriteRoute">
              <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,11">
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavRoute" />
                  </Grid.GestureRecognizers>
                  <Frame Style="{StaticResource RouteBadge}" Padding="8,3"
                         BackgroundColor="{Binding Number, Converter={StaticResource RouteColor}}"
                         BorderColor="{Binding Number, Converter={StaticResource RouteColor}}">
                    <Label Text="{Binding Number}" Style="{StaticResource RouteBadgeText}"
                           TextColor="{Binding Number, Converter={StaticResource RouteColor}, ConverterParameter=Text}" />
                  </Frame>
                  <Label Grid.Column="1" Text="{Binding DisplayName}"
                         FontAttributes="Bold" VerticalOptions="Center"
                         LineBreakMode="TailTruncation" />
                  <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource BrandBlue}"
                         VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
              </VerticalStackLayout>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </Frame>

      <Label Text="Dados públicos GTFS/GTFS-RT da Carris. Projeto independente, sem afiliação."
             Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"
             FontSize="11" Margin="8,4,8,0" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
