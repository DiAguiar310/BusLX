<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarrisRebuild.Models"
             x:Class="CarrisRebuild.Pages.StopsPage" BackgroundColor="{StaticResource AppBackground}"
             Title="Paragens">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="18,12,18,0" RowSpacing="10">
    <VerticalStackLayout Spacing="2">
      <Label Text="Rede de paragens" FontSize="25" FontAttributes="Bold" />
      <Label Text="Pesquisa por nome ou número." Style="{StaticResource MutedText}" />
    </VerticalStackLayout>

    <Frame Grid.Row="1" Style="{StaticResource SearchCard}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <Image Source="icon_search.png" WidthRequest="20" HeightRequest="20"
               Aspect="AspectFit" VerticalOptions="Center" />
        <Entry x:Name="Search" Grid.Column="1" Placeholder="Pesquisar paragem"
               Style="{StaticResource SearchEntry}" ClearButtonVisibility="WhileEditing"
               ReturnType="Search" TextChanged="OnSearch" Completed="OnSearchPressed" />
      </Grid>
    </Frame>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Label x:Name="CountLabel" TextColor="{StaticResource BrandBlue}"
             FontSize="12" FontAttributes="Bold" VerticalOptions="Center" Margin="2,0" />
      <Frame Grid.Column="1" Style="{StaticResource Pill}" Padding="9,4">
        <Label Text="CARRIS" Style="{StaticResource PillText}" />
      </Frame>
    </Grid>

    <CollectionView x:Name="List" Grid.Row="3" SelectionMode="None"
                    VerticalScrollBarVisibility="Never" Margin="0,0,0,20">
      <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
      </CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:BusStopDto">
          <Frame Style="{StaticResource Card}" Padding="14">
            <Frame.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnStopTap" CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Frame Style="{StaticResource StopBadge}">
                <Label Text="{Binding Number}" Style="{StaticResource StopBadgeText}" />
              </Frame>
              <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold"
                     VerticalOptions="Center" LineBreakMode="TailTruncation" />
              <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource BrandBlue}"
                     VerticalOptions="Center" />
            </Grid>
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
      <CollectionView.EmptyView>
        <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Padding="0,30">
          <Label Text="Sem resultados" FontAttributes="Bold" HorizontalTextAlignment="Center" />
          <Label Text="Tenta outro nome ou número." Style="{StaticResource MutedText}"
                 HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
    </CollectionView>
  </Grid>
</ContentPage>
