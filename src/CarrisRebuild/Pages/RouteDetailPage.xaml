<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarrisRebuild.Models"
             x:Class="CarrisRebuild.Pages.RouteDetailPage" BackgroundColor="{StaticResource AppBackground}"
             Title="Carreira">
  <ScrollView>
    <VerticalStackLayout Padding="18,12,18,26" Spacing="16">

      <Frame Style="{StaticResource RouteHero}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
          <Frame x:Name="NumberBadge" Grid.RowSpan="3"
                 BackgroundColor="{StaticResource BrandInk}"
                 BorderColor="{StaticResource BrandInk}"
                 CornerRadius="14" HasShadow="False" Padding="14,10" VerticalOptions="Center">
            <Label x:Name="NumberLabel" TextColor="{StaticResource BrandYellow}"
                   FontSize="26" FontAttributes="Bold" />
          </Frame>
          <Label Grid.Column="1" Text="CARREIRA" FontSize="10" FontAttributes="Bold"
                 TextColor="{StaticResource BrandYellow}" CharacterSpacing="1.2" />
          <Label x:Name="Header" Grid.Column="1" Grid.Row="1" Text="Carreira"
                 FontSize="21" FontAttributes="Bold" TextColor="{StaticResource CardWhite}"
                 LineBreakMode="WordWrap" Margin="0,2,0,0" />
          <Label x:Name="RouteNameLabel" Grid.Column="1" Grid.Row="2"
                 Text="Rede Carris · Lisboa" FontSize="12"
                 TextColor="{StaticResource OnBlueMuted}" />
        </Grid>
      </Frame>

      <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <BoxView Style="{StaticResource SectionBar}" />
          <Label Grid.Column="1" Text="Variantes" Style="{StaticResource SectionTitle}" />
        </Grid>
        <Label Text="Toca numa variante para escolher o sentido e ver as viaturas no mapa."
               Style="{StaticResource MutedText}" Margin="14,0,0,0" />
      </VerticalStackLayout>

      <Frame Style="{StaticResource Card}" Padding="14,4">
        <VerticalStackLayout x:Name="Variants" Spacing="0">
          <BindableLayout.EmptyViewTemplate>
            <DataTemplate>
              <Label Text="Sem variantes disponíveis." Style="{StaticResource MutedText}"
                     Padding="0,12" />
            </DataTemplate>
          </BindableLayout.EmptyViewTemplate>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:VariantDto">
              <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,11">
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVariantTap" />
                  </Grid.GestureRecognizers>
                  <Frame Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32"
                         Padding="0" CornerRadius="10">
                    <Label Text="→" FontAttributes="Bold" FontSize="15"
                           TextColor="{StaticResource BrandBlue}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Frame>
                  <Label Grid.Column="1" Text="{Binding Headsign}" FontAttributes="Bold"
                         VerticalOptions="Center" LineBreakMode="TailTruncation" />
                  <Label Grid.Column="2" Text="Mapa ›" FontSize="12" FontAttributes="Bold"
                         TextColor="{StaticResource BrandBlue}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
              </VerticalStackLayout>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </Frame>

      <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <BoxView Style="{StaticResource SectionBar}" />
          <Label Grid.Column="1" Text="Viaturas em tempo real" Style="{StaticResource SectionTitle}" />
        </Grid>
        <Label Text="Abre o mapa filtrado por sentido ou vê toda a carreira."
               Style="{StaticResource MutedText}" Margin="14,0,0,0" />
      </VerticalStackLayout>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Button x:Name="IdaButton" Text="Ida" Style="{StaticResource PrimaryButton}"
                FontSize="13" Clicked="OnMapIda" />
        <Button x:Name="VoltaButton" Grid.Column="1" Text="Volta"
                Style="{StaticResource OutlineButton}" FontSize="13" Clicked="OnMapVolta" />
      </Grid>
      <Button Text="Ver todas as viaturas" Style="{StaticResource GhostButton}" Clicked="OnMap" />
      <Button x:Name="FavButton" Text="☆ Guardar carreira"
              Style="{StaticResource OutlineButton}" Clicked="OnFav" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
