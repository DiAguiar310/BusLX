<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarrisRebuild.Pages.AboutPage" BackgroundColor="{StaticResource AppBackground}"
             Title="Mais">
  <ScrollView>
    <VerticalStackLayout Padding="18,12,18,28" Spacing="16">

      <Frame Style="{StaticResource RouteHero}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Frame BackgroundColor="{StaticResource CardWhite}"
                 BorderColor="{StaticResource CardWhite}" CornerRadius="18"
                 Padding="7" HasShadow="False" VerticalOptions="Center">
            <Image Source="brand_mark.png" WidthRequest="58" HeightRequest="58"
                   Aspect="AspectFit" />
          </Frame>
          <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
            <Label Text="BusLX" FontSize="28" FontAttributes="Bold"
                   TextColor="{StaticResource CardWhite}" />
            <Label Text="Mobilidade em Lisboa, com dados abertos."
                   FontSize="13" TextColor="{StaticResource OnBlueMuted}" />
            <Frame BackgroundColor="{StaticResource BrandYellow}"
                   BorderColor="{StaticResource BrandYellow}" CornerRadius="99"
                   Padding="8,4" HorizontalOptions="Start" HasShadow="False"
                   Margin="0,3,0,0">
              <Label Text="VERSÃO 1.1 · ANDROID" FontSize="9" FontAttributes="Bold"
                     TextColor="{StaticResource BrandInk}" CharacterSpacing="0.5" />
            </Frame>
          </VerticalStackLayout>
        </Grid>
      </Frame>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <BoxView Style="{StaticResource SectionBar}" />
        <Label Grid.Column="1" Text="Sobre" Style="{StaticResource SectionTitle}" />
      </Grid>

      <Frame Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="DADOS ABERTOS" Style="{StaticResource Eyebrow}" />
          <Label Text="A rede Carris, no teu bolso." FontSize="17" FontAttributes="Bold" />
          <Label Text="Os horários e as posições dos autocarros vêm dos feeds públicos GTFS e GTFS-RT da Carris. O mapa usa OpenStreetMap/CARTO."
                 Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
      </Frame>

      <Frame Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="PROJETO INDEPENDENTE" Style="{StaticResource Eyebrow}" />
          <Label Text="Sem afiliação com a Carris." FontSize="17" FontAttributes="Bold" />
          <Label Text="A BusLX é um projeto independente. Não são usados logótipos, imagens ou credenciais da aplicação original."
                 Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
      </Frame>

      <Frame Style="{StaticResource Card}" BackgroundColor="{StaticResource BlueSoft}"
             BorderColor="{StaticResource BlueSoft}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Frame Style="{StaticResource IconTile}" BackgroundColor="{StaticResource CardWhite}"
                 BorderColor="{StaticResource CardWhite}">
            <Label Text="LX" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource BrandBlue}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Frame>
          <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
            <Label Text="Feito em Lisboa" FontAttributes="Bold" />
            <Label Text="Dados públicos, utilização simples." Style="{StaticResource MutedText}" />
          </VerticalStackLayout>
        </Grid>
      </Frame>

      <Label Text="Feito em Lisboa · 2026" Style="{StaticResource MutedText}"
             HorizontalOptions="Center" Margin="0,6,0,0" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
